# Optional exact SSID/password for the access point created on a fresh device.
# With no SSID, firmware derives meterXX from the device's generated identity.
# With no password, the initial access point is open. WPA2 passwords must be
# at least eight characters.
# POWER_METER_AP_SSID=meter
# POWER_METER_AP_PASSWORD=replace-with-an-ap-password
